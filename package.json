{
  "name": "revu",
  "version": "0.1.0",
  "description": "Local code review tool with a GitHub/GitLab-like UI for local git changes and pull requests.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node --watch scripts/dev.ts",
    "build": "vite build && vite build --config vite.server.config.ts && node scripts/finish-build.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bench": "node scripts/bench.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.26",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
